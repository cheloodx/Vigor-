{
  "expo": {
    "name": "WiFi Access",
    "slug": "wifi-access",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#3B82F6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wifiaccess.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "WiFi Access necesită locația ta pentru a găsi hotspot-uri WiFi în apropiere.",
        "NSLocationAlwaysUsageDescription": "WiFi Access necesită locația ta pentru a te conecta automat la hotspot-uri WiFi."
      }
    },
    "android": {
      "package": "com.wifiaccess.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#3B82F6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WiFi Access necesită locația ta pentru a găsi hotspot-uri WiFi în apropiere."
        }
      ]
    ]
  }
}
