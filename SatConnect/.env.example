# Supabase (required for real auth)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Airalo eSIM API (optional - mock mode if empty)
EXPO_PUBLIC_AIRALO_BASE_URL=https://sandbox-partners-api.airalo.com
EXPO_PUBLIC_AIRALO_CLIENT_ID=
EXPO_PUBLIC_AIRALO_CLIENT_SECRET=
EXPO_PUBLIC_AIRALO_MODE=sandbox

# Backend API (optional - local mock if empty)
EXPO_PUBLIC_BACKEND_URL=http://localhost:3001
