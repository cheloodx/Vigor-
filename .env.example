# AutoDiag Pro - Environment Variables
# Copy this file to .env and fill in your values

# Backend API URL (Hetzner server)
VITE_API_URL=https://agenticmax.co.uk/autodiag

# Frontend base URL (your deployed domain)
VITE_APP_URL=https://autodiagpro.ro

# Supabase Auth & Database
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe Payments (publishable key only - secret key stays on backend)
VITE_STRIPE_PUBLIC_KEY=pk_live_your-key-here
