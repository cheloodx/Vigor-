	<string>AutoDiag Pro foloseste Bluetooth pentru conectarea la adaptorul OBD2 ELM327.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
